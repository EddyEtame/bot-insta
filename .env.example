# Server
PORT=3000

# Meta webhook verification and signature validation
META_VERIFY_TOKEN=replace_with_a_long_random_string
META_APP_SECRET=replace_with_your_meta_app_secret
INSTAGRAM_ACCESS_TOKEN=replace_with_a_valid_instagram_access_token
# Set this to the current supported Graph API version verified in your Meta app.
META_API_VERSION=verified_supported_version

# Instagram API mode. Use instagram_login for the newer Instagram Login flow,
# or facebook_login for a Facebook Page-connected Instagram professional account.
INSTAGRAM_API_MODE=instagram_login
INSTAGRAM_ACCOUNT_ID=your_instagram_professional_account_id

# OpenAI
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5-mini

# Business facts are files, not a giant prompt or environment variable.
KNOWLEDGE_BASE_PATH=./knowledge

# Session memory. SESSION_STORE=file keeps conversations and delivery ids across restarts.
SESSION_STORE=memory
SESSION_STORE_PATH=./.data/sessions.json
SESSION_TTL_HOURS=24
MAX_MESSAGES_PER_MINUTE=8

# Optional: POST an escalation payload, and the weekly corpus report, to a private owner workflow.
ESCALATION_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Weekly corpus poll (plannings, informations pratiques, offres de chaque salle)
# ---------------------------------------------------------------------------
# Turn the in-process scheduler on. Off by default so a local run never crawls.
KNOWLEDGE_SYNC_ENABLED=false
# Sunday 04:30 Europe/Paris, daylight saving included.
KNOWLEDGE_SYNC_DAY=sunday
KNOWLEDGE_SYNC_HOUR=4
KNOWLEDGE_SYNC_MINUTE=30
KNOWLEDGE_SYNC_TIMEZONE=Europe/Paris
# Catch up at boot when the last successful poll is older than a week.
KNOWLEDGE_SYNC_RUN_IF_STALE=true
# Identify the bot honestly, with a contact address the club owns.
KNOWLEDGE_SYNC_USER_AGENT=BoxingCenterSupportBot/1.0 (+https://www.boxingcenter.fr; contact: secretariat.boxingcenter@gmail.com)
# Extra hosts allowed for fetching, on top of knowledge/registry/gyms.json (comma separated).
# Anything fetched outside the registry hosts is stored as pending_review and never answered.
KNOWLEDGE_SYNC_ALLOWED_HOSTS=
KNOWLEDGE_SYNC_TIMEOUT_MS=15000
KNOWLEDGE_SYNC_MAX_BYTES=2000000
KNOWLEDGE_SYNC_MAX_PAGES=12
KNOWLEDGE_SYNC_DELAY_MS=1200
KNOWLEDGE_SYNC_RETRIES=2
KNOWLEDGE_SYNC_KEEP_SNAPSHOTS=6
KNOWLEDGE_SYNC_PROBE_COOLDOWN_DAYS=14
# Optional local export folder (for example a clone of the Plannings repository).
BC_PLANNINGS_PATH=

# Freshness budgets, in days. Past the budget a fact stops being evidence and the
# conversation is handed to the team instead of quoting a stale planning.
KNOWLEDGE_MAX_AGE_PLANNING_DAYS=10
KNOWLEDGE_MAX_AGE_OFFER_DAYS=21
KNOWLEDGE_MAX_AGE_PROFILE_DAYS=120
