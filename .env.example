# Server
PORT=3000

# Meta webhook verification and signature validation
META_VERIFY_TOKEN=replace_with_a_long_random_string
META_APP_SECRET=replace_with_your_meta_app_secret
INSTAGRAM_ACCESS_TOKEN=replace_with_a_valid_instagram_access_token
# Set this to the current supported Graph API version verified in your Meta app.
META_API_VERSION=verified_supported_version

# Instagram API mode. Use instagram_login for the newer Instagram Login flow,
# or facebook_login for a Facebook Page-connected Instagram professional account.
INSTAGRAM_API_MODE=instagram_login
INSTAGRAM_ACCOUNT_ID=your_instagram_professional_account_id

# OpenAI
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5-mini

# Business facts are files, not a giant prompt or environment variable.
KNOWLEDGE_BASE_PATH=./knowledge

# In-memory V1 safeguards. Move these to durable infrastructure before production.
SESSION_TTL_HOURS=24
MAX_MESSAGES_PER_MINUTE=8

# Optional: POST an escalation payload to a private owner workflow.
ESCALATION_WEBHOOK_URL=
